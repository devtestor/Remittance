# Browser and iOS simulator can use localhost. Android emulator uses 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL="http://10.0.2.2:4000"

# For a physical phone, replace the API URL with the development machine LAN IP.
# EXPO_PUBLIC_API_BASE_URL="http://192.168.1.20:4000"

# Smile sandbox values are only required when testing hosted KYC.
# EXPO_PUBLIC_SMILE_PARTNER_ID=""
# EXPO_PUBLIC_SMILE_CALLBACK_URL=""
# EXPO_PUBLIC_SMILE_POLICY_URL=""
# EXPO_PUBLIC_SMILE_LOGO_URL=""
# EXPO_PUBLIC_SMILE_ENVIRONMENT="sandbox"
